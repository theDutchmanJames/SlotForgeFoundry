{
  "name": "slotforge-foundry",
  "version": "1.5.0",
  "productName": "SlotForge Foundry",
  "description": "SlotForge Foundry: slot-car track maker and STL editor",
  "author": "theDutchmanJames",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/theDutchmanJames/SlotForgeFoundry",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/package.mjs",
    "test": "node --test tests/*.test.js desktop/*.test.cjs",
    "test:ui": "node tests/browser.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** tests/*.test.js",
    "test:windows": "node tests/robustness/windows.mjs",
    "test:crash": "node tests/robustness/crash.mjs",
    "test:monkey": "node tests/robustness/monkey.mjs",
    "start": "npm run build && electron .",
    "start:portable": "electron . --portable-data-dir=.qa/portable",
    "shots": "node scripts/readme-shots.mjs",
    "test:desktop": "node desktop/smoke.cjs",
    "test:desktop-ui": "node desktop/ui-test-runner.cjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "lucide": "^1.77.0",
    "manifold-3d": "^3.5.5",
    "polygon-clipping": "0.15.7",
    "sql.js": "1.17.0",
    "svgpath": "^2.6.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "playwright-core": "^1.65.1",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "build": {
    "appId": "nl.slotforge.foundry",
    "productName": "SlotForge Foundry",
    "executableName": "SlotForgeFoundry",
    "directories": {
      "output": "dist/desktop/v${version}",
      "buildResources": "desktop/build"
    },
    "files": [
      "package.json",
      "desktop/*.cjs",
      "!desktop/*.test.cjs",
      "!desktop/smoke.cjs",
      "!desktop/ui-tests.cjs",
      "!desktop/ui-test-runner.cjs",
      "desktop/build/icon.*",
      "dist/index.html",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "SlotForge-Foundry-LICENSE.txt"
      },
      {
        "from": "dist/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "SlotForgeFoundry-${version}-Portable-${arch}.${ext}",
      "unpackDirName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SlotForge Foundry",
      "uninstallDisplayName": "SlotForge Foundry",
      "installerIcon": "desktop/build/icon.ico",
      "uninstallerIcon": "desktop/build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "artifactName": "SlotForgeFoundry-${version}-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "desktop/build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "SlotForgeFoundry-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "SlotForge Foundry ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "desktop/build/icon.png",
      "maintainer": "theDutchmanJames",
      "synopsis": "Slot-car track maker and STL editor",
      "artifactName": "SlotForgeFoundry-${version}-linux-${arch}.${ext}"
    }
  }
}
